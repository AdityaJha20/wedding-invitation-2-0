# ==============================================================================
# Sarthak & Manya Wedding Invitation — Environment Configuration
# ==============================================================================

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<db_user>:<db_password>@<cluster-address>/wedding_invitation?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret Key for Admin Authentication Cookie (min 32 random characters recommended)
JWT_SECRET=replace_with_a_secure_random_secret_in_production

# Port for Express Backend Server
PORT=5000

# Client Frontend Origin for CORS (Vite development default is http://localhost:5173)
CLIENT_URL=http://localhost:5173

# Optional: Admin Seed Configuration (Used by npm run create-admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Frontend API Base URL (leave empty in development to use Vite's built-in proxy)
VITE_API_BASE_URL=

# Guest Photo Collection
# Storage provider for guest photos. Development defaults to "local".
# In production, guest uploads stay CLOSED unless a production-safe provider (Google Drive, coming later)
# is configured and verified. "local" is development-only and never accepts uploads in production.
PHOTO_STORAGE_PROVIDER=
# Optional: folder for development-only local photo storage (default: ./.photo-uploads)
PHOTO_STORAGE_DIR=
# Public website address used for the common wedding QR code (e.g. https://your-wedding-site.com)
VITE_PUBLIC_SITE_URL=
